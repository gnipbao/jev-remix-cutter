{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jev-remix.local/contracts/intent.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "arc": {
      "type": [
        "array",
        "string"
      ]
    },
    "hook": {
      "type": [
        "string",
        "object"
      ]
    },
    "threads": {
      "type": "array",
      "items": {
        "type": [
          "object",
          "string"
        ]
      }
    },
    "montage": {
      "type": [
        "array",
        "object",
        "string"
      ]
    },
    "counterpoint": {
      "type": [
        "array",
        "object"
      ]
    },
    "look_override": {
      "type": [
        "array",
        "object"
      ]
    },
    "avoid": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "narration": {
      "type": "object"
    },
    "slot_overrides": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/slotOverride"
      }
    },
    "music_slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/slotOverride"},
          {
            "type": "object",
            "properties": {
              "start_f": {"type": "integer", "minimum": 0},
              "end_f": {"type": "integer", "minimum": 1},
              "need": {"type": "string", "minLength": 1},
              "mood": {"type": "string", "minLength": 1},
              "section": {"type": "string", "minLength": 1},
              "accent_f": {"type": "integer", "minimum": 0}
            },
            "required": ["start_f", "end_f", "need"]
          }
        ]
      }
    }
  },
  "$defs": {
    "slotOverride": {
      "type": "object",
      "properties": {
        "allowed_shots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_range": {
          "type": "object",
          "properties": {
            "in_us": {"type": "integer", "minimum": 0},
            "out_us": {"type": "integer", "minimum": 1}
          },
          "required": ["in_us", "out_us"],
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "required": [
    "theme",
    "arc",
    "hook",
    "avoid"
  ],
  "additionalProperties": true
}
