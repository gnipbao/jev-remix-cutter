{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jev-remix.local/contracts/timeline.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "fps": {
      "type": "integer",
      "minimum": 1
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "duration_frames": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string"
          },
          "out": {
            "type": "object",
            "properties": {
              "start_f": {
                "type": "integer",
                "minimum": 0
              },
              "end_f": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "start_f",
              "end_f"
            ],
            "additionalProperties": true
          },
          "src": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "in_us": {
                "type": "integer",
                "minimum": 0
              },
              "out_us": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "source",
              "in_us",
              "out_us"
            ],
            "additionalProperties": true
          },
          "retime": {
            "type": "object"
          },
          "transform": {
            "type": "object"
          },
          "transition_in": {
            "type": "object"
          },
          "look": {
            "type": "object"
          },
          "fx": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "sfx": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "reasons": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "source_audio": {
            "type": "boolean"
          },
          "face_ops": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "slot",
          "out",
          "src"
        ],
        "additionalProperties": true
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "source": {"type": "string"},
              "in_us": {"type": "integer", "minimum": 0},
              "out_us": {"type": "integer", "minimum": 1},
              "start_f": {"type": "integer", "minimum": 0},
              "end_f": {"type": "integer", "minimum": 1},
              "source_audio": {"type": "boolean"},
              "unaltered": {"type": "boolean"}
            },
            "required": ["source", "in_us", "out_us", "start_f", "end_f", "source_audio", "unaltered"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "dependencies": {
      "type": "object"
    },
    "mock": {
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "fps",
    "width",
    "height",
    "duration_frames",
    "items",
    "dependencies",
    "mock"
  ],
  "additionalProperties": true
}
