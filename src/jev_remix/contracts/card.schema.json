{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jev-remix.local/contracts/card.schema.json",
  "type": "object",
  "properties": {
    "shot_id": {
      "type": "string"
    },
    "words": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "agent",
            "provider"
          ]
        },
        "model": {
          "type": "string"
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "uncertain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "mode",
        "frames"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "shot_id",
    "words",
    "provenance"
  ],
  "additionalProperties": true
}
